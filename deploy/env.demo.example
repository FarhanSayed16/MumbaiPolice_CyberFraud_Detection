# Copy to deploy/.env.demo and edit before `docker compose ... --env-file deploy/.env.demo`

# Public host only (no https://) — IP or DuckDNS name
PUBLIC_HOST=YOUR_PUBLIC_IP_OR_DOMAIN

# Strong random — required when ENVIRONMENT=demo
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

POSTGRES_PASSWORD=ChangeMe_Postgres_2026
NEO4J_PASSWORD=ChangeMe_Neo4j_2026

# Used by Caddy for ACME; set to your email for Let's Encrypt
ACME_EMAIL=you@example.com
