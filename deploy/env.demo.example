# Copy to deploy/.env.demo and edit before `docker compose ... --env-file deploy/.env.demo`

# Public host only (no https://) — DuckDNS hostname strongly preferred (for free HTTPS)
PUBLIC_HOST=kavach-demo.duckdns.org

# Strong random — required when ENVIRONMENT=demo (must NOT start with local-dev-secret)
# Generate: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

POSTGRES_PASSWORD=ChangeMe_Postgres_2026
NEO4J_PASSWORD=ChangeMe_Neo4j_2026

# Let's Encrypt / Caddy
ACME_EMAIL=you@example.com

# After stack is up, seed once:
# docker compose -f deploy/docker-compose.demo.yml exec -e ALLOW_DEMO_SEED=true backend python -m scripts.seed
