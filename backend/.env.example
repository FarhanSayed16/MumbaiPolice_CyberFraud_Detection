# App Environment & Identity
PROJECT_NAME="Trace-X"
# local = laptop dev | demo = DCP / Cloudflare tunnel
ENVIRONMENT=demo
DEBUG=False
API_V1_PREFIX=/api/v1

# Security & Auth — must NOT be local-dev-secret when ENVIRONMENT=demo
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_ENABLED=True
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
ALLOW_BEARER_AUTH=False

DUPLICATE_COMPLAINANT_WINDOW_DAYS=30
DUPLICATE_SUSPECT_ACCOUNT_WINDOW_DAYS=60

UPLOAD_DIR=uploads
INGESTION_INLINE_FALLBACK=True
GRAPH_SYNC_ON_IMPORT=defer

SENTRY_DSN=

POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=mumbaicyber
DATABASE_URL=postgresql+asyncpg://postgres:secretpassword@localhost:5433/mumbaicyber

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6380/0

EMAIL_DELIVERY_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
