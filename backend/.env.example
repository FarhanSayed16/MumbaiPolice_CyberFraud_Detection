# App Environment & Identity
PROJECT_NAME="Mumbai Police Cyber Fraud Detection Platform"
ENVIRONMENT="local"  # local | staging | demo | production
DEBUG=True
API_V1_PREFIX="/api/v1"

# Security & Auth
SECRET_KEY="local-dev-secret-key-change-in-production-instantly"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_ENABLED=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# H3: Bearer Authorization allowed only in local/test (auto-disabled outside local)
ALLOW_BEARER_AUTH=True

# Duplicate detection windows (days)
DUPLICATE_COMPLAINANT_WINDOW_DAYS=30
DUPLICATE_SUSPECT_ACCOUNT_WINDOW_DAYS=60

# Phase 7 ingestion
UPLOAD_DIR=uploads
INGESTION_INLINE_FALLBACK=True
GRAPH_SYNC_ON_IMPORT=defer

# Observability (optional — leave empty locally)
SENTRY_DSN=""

# PostgreSQL Connection (Async engine)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5433
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secretpassword"
POSTGRES_DB="mumbaicyber"
DATABASE_URL="postgresql+asyncpg://postgres:secretpassword@localhost:5433/mumbaicyber"

# Neo4j Graph DB Connection
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="secretpassword"

# Redis / ARQ Background Queue Connection
REDIS_HOST="localhost"
REDIS_PORT=6380
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6380/0"

# Email delivery — set EMAIL_DELIVERY_MODE=smtp and fill SMTP_* (never commit real passwords)
EMAIL_DELIVERY_MODE=mock
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS=true

