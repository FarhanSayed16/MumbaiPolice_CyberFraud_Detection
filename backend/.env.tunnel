# Backend environment for Cloudflare Tunnel / DCP demo
# Repo uses backend/.env with the same pattern (gitignored).

ENVIRONMENT=demo
DEBUG=False
SECRET_KEY=kavach-dcp-demo-use-a-long-unique-string
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
INGESTION_INLINE_FALLBACK=True
EMAIL_DELIVERY_MODE=mock
DATABASE_URL=postgresql+asyncpg://postgres:secretpassword@localhost:5433/mumbaicyber
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword
REDIS_URL=redis://localhost:6380/0
